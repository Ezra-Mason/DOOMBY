# Visual Studio 2015 user specific files
DOOMBY/.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Precompiled Assets
DOOMBY/SourceArt/**/*.png
DOOMBY/SourceArt/**/*.tga

# Binary Files
DOOMBY/Binaries/*
DOOMBY/Plugins/**/Binaries/*

# Builds
DOOMBY/Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!DOOMBY/Build/*/
DOOMBY/Build/*/**
!DOOMBY/Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!DOOMBY/Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
DOOMBY/Saved/*

# Compiled source files for the engine to use
DOOMBY/Intermediate/*
DOOMBY/Plugins/**/Intermediate/*

# Cache files for the editor to use
DOOMBY/DerivedDataCache/*
